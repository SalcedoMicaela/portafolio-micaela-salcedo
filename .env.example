# Cloudinary — tu cloud es djejlmpnv
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=djejlmpnv

# Para subir imágenes vía API (opcional, solo si usas backend)
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Tu API_SECRET termina en ...gxcg2jrTxE (ya está puesto), solo reemplaza <your_api_key>
CLOUDINARY_URL=cloudinary://<your_api_key>:JpNXw_YrxvlvORfAmgxcg2jrTxE@djejlmpnv

# Cómo obtener API_KEY:
# 1. Ve a https://console.cloudinary.com/ -> Dashboard
# 2. Copia "API Key" y pégalo donde dice <your_api_key>
# 3. En Vercel: Settings -> Environment Variables -> pega CLOUDINARY_URL completo y NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
